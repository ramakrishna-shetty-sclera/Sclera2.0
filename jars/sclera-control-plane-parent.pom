<?xml version="1.0" encoding="UTF-8"?>
<!--
    LOCAL STUB of the unpublished com.sclera:sclera-control-plane parent POM.

    sclera2.0v-api-gateway declares this artifact as its Maven parent with an
    empty relativePath (resolved from a repository: sclera-build-base in Docker,
    GitHub Packages in CI). Neither source is available in this workspace, so
    this stub supplies the pieces the gateway build actually consumes:
      - Spring Boot 3.3.7 parent (plugin management, dependency BOM)
      - Spring Cloud 2023.0.6 BOM (spring-cloud-starter-gateway)
      - pinned versions for sclera-common, Dapr, springdoc, logstash, jqwik
        (mirroring the versions used by the application-plane services)
      - bcprov (TestAuthExchangeController's Ed25519 verifier expects it
        on the classpath, provided by the real parent)

    Install (see README "API gateway" section):
      mvn install:install-file "-Dfile=jars/sclera-control-plane-parent.pom" \
        "-DgroupId=com.sclera" "-DartifactId=sclera-control-plane" \
        "-Dversion=0.1.0-SNAPSHOT" "-Dpackaging=pom"
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.7</version>
        <relativePath/>
    </parent>

    <groupId>com.sclera</groupId>
    <artifactId>sclera-control-plane</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Sclera Control Plane (local parent stub)</name>

    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2023.0.6</spring-cloud.version>
        <sclera-common.version>0.1.0-SNAPSHOT</sclera-common.version>
        <dapr-sdk.version>1.13.1</dapr-sdk.version>
        <springdoc.version>2.6.0</springdoc.version>
        <logstash-logback.version>7.4</logstash-logback.version>
        <jqwik.version>1.8.4</jqwik.version>
        <bouncycastle.version>1.78.1</bouncycastle.version>
        <!-- Gateway code references JWSAlgorithm.Ed25519, added after the
             9.37.x that Boot 3.3.7 manages. -->
        <nimbus-jose-jwt.version>10.3</nimbus-jose-jwt.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.sclera</groupId>
                <artifactId>sclera-common</artifactId>
                <version>${sclera-common.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sclera</groupId>
                <artifactId>sclera-common-test</artifactId>
                <version>${sclera-common.version}</version>
            </dependency>
            <dependency>
                <groupId>io.dapr</groupId>
                <artifactId>dapr-sdk</artifactId>
                <version>${dapr-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>io.dapr</groupId>
                <artifactId>dapr-sdk-springboot</artifactId>
                <version>${dapr-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback.version}</version>
            </dependency>
            <dependency>
                <groupId>net.jqwik</groupId>
                <artifactId>jqwik</artifactId>
                <version>${jqwik.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nimbusds</groupId>
                <artifactId>nimbus-jose-jwt</artifactId>
                <version>${nimbus-jose-jwt.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Inherited by every child module, matching the real parent's
             classpath guarantee ("bcprov-jdk18on already on the classpath"). -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>
        <!-- The real gateway build ships spring-webmvc + embedded Tomcat even
             though the app runs reactive (spring.main.web-application-type:
             reactive is pinned in every profile). Without them, component
             scanning of com.sclera.controlplane.common fails on servlet-only
             classes like ResponseEnvelopeAdvice (ResponseBodyAdvice is an MVC
             type). Mirrored here for the same reason. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- sclera-common's CaffeineCacheConfig instantiates a Caffeine cache
             manager unconditionally; the class must be on the classpath. -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <!-- sclera-common's TracingConfig registers a micrometer ObservedAspect
             (AOP); needs aspectjweaver on the classpath. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
    </dependencies>
</project>
