<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sclera</groupId>
        <artifactId>sclera-application-plane</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>sclera-calendar-service</artifactId>
    <name>Sclera Calendar Service</name>
    <description>Per-property date/time rules: timezone + locale, working hours, holidays, downtime windows and availability queries (schema-per-tenant Postgres)</description>

    <dependencies>
        <!-- Shared platform library: auth, envelope, errors, MDC, health -->
        <dependency>
            <groupId>com.sclera</groupId>
            <artifactId>sclera-common</artifactId>
        </dependency>

        <!--
            sclera-common is a bare jar (no transitives) — declare everything its
            classes need at runtime.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Persistence: schema-per-tenant Postgres (sclera_calendar DB) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- sclera-common's cache-invalidation listener references spring-data-redis
             (incl. reactive) types on scan, so the classes must be present. Redis
             itself is the local sclera-redis container. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- sclera-common's TracingConfig registers a micrometer ObservedAspect
             (AOP) → needs aspectjweaver on the classpath. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- sclera-common's ResponseEnvelope advice does an instanceof Page check,
             so the Page/Pageable types must be present even without JPA. -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-commons</artifactId>
        </dependency>

        <!-- Dapr SDK: /internal/** availability endpoints are invoked over Dapr;
             also referenced by sclera-common's Dapr* config/health classes on scan -->
        <dependency>
            <groupId>io.dapr</groupId>
            <artifactId>dapr-sdk</artifactId>
        </dependency>

        <!-- OpenFGA: fine-grained authorization (relationship tuples + checks) -->
        <dependency>
            <groupId>dev.openfga</groupId>
            <artifactId>openfga-sdk</artifactId>
        </dependency>

        <!-- OpenAPI + observability + cache (required by sclera-common configs) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Integration tests run against a real, throwaway Postgres container.
             H2 cannot do CREATE SCHEMA + search_path switching + JSONB, which is
             the whole schema-per-tenant mechanism, so it would test nothing that
             matters. Versions come from the Spring Boot parent. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- *IT classes run on `mvn verify` (they need Docker); `mvn test`
                 stays unit-only. Without this plugin Surefire matches only
                 *Test/*Tests, so *IT classes are silently never discovered and
                 the build reports "Tests run: 0" while passing. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!-- Testcontainers' docker-java defaults to Docker API
                             1.32; Docker Engine 29+ rejects anything below 1.40
                             with a 400, which surfaces as "Could not find a valid
                             Docker environment" even though the CLI works. 1.40 is
                             the one value that suits both ends — the ceiling of
                             Docker 19.03 and the floor of 29.x. Note docker-java
                             reads the api.version system property; the
                             DOCKER_API_VERSION env var is NOT read. -->
                        <api.version>1.40</api.version>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
